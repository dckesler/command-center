# Copy to .env (git-ignored). Bun loads it automatically when you run `bun start`.
# These are secrets/credentials; non-secret settings live in config.json (see config.example.json).

# Cursor SDK — hub specialists and Cloud agents. https://cursor.com/settings → API keys
CURSOR_API_KEY=

# Jira REST (status transitions, sprint field, epic children). acli handles the rest.
JIRA_EMAIL=
JIRA_API_TOKEN=
# JIRA_BASE_URL=https://your-site.atlassian.net   # overrides jira.baseUrl in config.json

# Optional overrides of config.json values
# CC_CONFIG_DIR=~/.config/command-center
# CC_PROJECTS_DIR=~/projects
# CC_AGENT_CMD=cursor-cli
# CC_MODEL=composer-2.5
# MKPANES_BIN=~/.local/bin/mkpanes
