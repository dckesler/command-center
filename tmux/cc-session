#!/usr/bin/env bash
# cc-session — number tmux sessions so they can be shown and picked like tabs.
#
#   cc-session index                       (re)assign @idx / @label on every session
#   cc-session go <n> [client]             switch to session number <n>
#   cc-session next|prev [session] [client] switch to the neighbouring number (wraps)
#   cc-session list                        print "idx  name" for every session
#
# From a key binding pass the context explicitly — run-shell expands formats
# but does not set TMUX_PANE: `run-shell "cc-session next '#{session_id}' '#{client_name}'"`.
# From a shell inside tmux the arguments can be omitted (TMUX_PANE is used).
#
# Sessions are ordered by creation (session id), which is the order tmux's
# #{S:…} status loop draws them in — so the numbers on the status line, Alt-N
# and Tab/BTab all agree. (switch-client -n/-p walks sessions by *name*, which
# is a different order; that's why this script does next/prev itself.)
# Session "0" (the Command Center work session) is always 0; every other
# session gets 1..N. @label is the display name (upper-cased, the work session
# reads COMMAND CENTER). command-center.tmux runs `index` from hooks whenever
# a session is created, closed or renamed.
set -euo pipefail

cmd="${1:-index}"

# "$id name" per line in creation order; ids ($23) are unambiguous targets,
# names like "0" are not.
sessions() {
  tmux list-sessions -F '#{session_id} #S' 2>/dev/null | sort -t'$' -k2 -n
}

label_for() {
  local name="$1"
  if [ "$name" = "0" ]; then
    printf 'COMMAND CENTER'
  else
    printf '%s' "$name" | tr '[:lower:]' '[:upper:]'
  fi
}

# Switch the client the key was pressed in ($CLIENT); fall back to tmux's idea
# of the current client (the most recent one on this pane's session).
CLIENT=""
switch_to() {
  local target="$1"
  if [ -z "$CLIENT" ] && [ -n "${TMUX_PANE:-}" ]; then
    CLIENT="$(tmux display-message -p -t "$TMUX_PANE" '#{client_name}' 2>/dev/null || true)"
  fi
  [ -n "$CLIENT" ] && exec tmux switch-client -c "$CLIENT" -t "$target"
  exec tmux switch-client -t "$target"
}

current_session() {
  if [ -n "${1:-}" ]; then printf '%s' "$1"
  elif [ -n "${TMUX_PANE:-}" ]; then tmux display-message -p -t "$TMUX_PANE" '#{session_id}'
  else echo "cc-session: pass a session id or run inside tmux" >&2; exit 1
  fi
}

case "$cmd" in
  index)
    i=0
    while read -r id name; do
      [ -n "$id" ] || continue
      if [ "$name" = "0" ]; then idx=0; else i=$((i + 1)); idx=$i; fi
      tmux set-option -t "$id" @idx "$idx" \; \
           set-option -t "$id" @label "$(label_for "$name")"
    done < <(sessions)
    ;;
  list)
    while read -r id name; do
      [ -n "$id" ] || continue
      printf '%s  %s\n' "$(tmux show-option -qv -t "$id" @idx)" "$name"
    done < <(sessions)
    ;;
  go)
    want="${2:?usage: cc-session go <n> [client]}"
    CLIENT="${3:-}"
    while read -r id name; do
      [ -n "$id" ] || continue
      if [ "$(tmux show-option -qv -t "$id" @idx)" = "$want" ]; then switch_to "$id"; fi
    done < <(sessions)
    # exit 0: a non-zero status makes tmux add its own "returned 1" message.
    tmux display-message "no session $want"
    ;;
  next|prev)
    current="$(current_session "${2:-}")"
    CLIENT="${3:-}"
    ids=()
    while read -r id name; do [ -n "$id" ] && ids+=("$id"); done < <(sessions)
    n=${#ids[@]}
    [ "$n" -gt 1 ] || exit 0
    pos=0
    for k in "${!ids[@]}"; do [ "${ids[$k]}" = "$current" ] && pos=$k; done
    if [ "$cmd" = next ]; then pos=$(( (pos + 1) % n )); else pos=$(( (pos - 1 + n) % n )); fi
    switch_to "${ids[$pos]}"
    ;;
  *)
    echo "usage: cc-session index | list | go <n> [client] | next|prev [session] [client]" >&2
    exit 2
    ;;
esac
