#!/usr/bin/env bash
# cc-snapshot — save the live Command Center (tmux sessions, windows, panes, agent conversations) to a file (see src/cli/snapshot.ts).
# Restore it later with cc-restore.
#
#   cc-snapshot save [name] [--note "…"] | list | show [name]
set -euo pipefail

# Resolve the command-center checkout from this script's real location
# (~/.local/bin/cc-snapshot is a symlink into the repo).
SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$DIR/$SELF" ;; esac
done
REPO="$(cd "$(dirname "$SELF")/../.." && pwd)"

BUN="$(command -v bun || true)"
for c in "$HOME/.bun/bin/bun" /opt/homebrew/bin/bun /usr/local/bin/bun; do
  [ -n "$BUN" ] && break
  [ -x "$c" ] && BUN="$c"
done
if [ -z "$BUN" ]; then
  echo "cc-snapshot: bun not found" >&2
  exit 1
fi

exec "$BUN" run "$REPO/src/cli/snapshot.ts" "$@"
