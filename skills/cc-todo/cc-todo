#!/usr/bin/env bash
# cc-todo — Command Center's todo list from the shell (see src/cli/todo.ts).
# Used by the tmux central agent for the focus loop: list / focus / note / add / done.
#
#   cc-todo list [--all] | focus | note [--checkin] <id|text> <text…> | focus <id|text> on|off | add [--focus] <text…> | done <id|text>
set -euo pipefail

# Resolve the command-center checkout from this script's real location
# (~/.local/bin/cc-todo is a symlink into the repo).
SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$DIR/$SELF" ;; esac
done
REPO="$(cd "$(dirname "$SELF")/../.." && pwd)"

BUN="$(command -v bun || true)"
for c in "$HOME/.bun/bin/bun" /opt/homebrew/bin/bun /usr/local/bin/bun; do
  [ -n "$BUN" ] && break
  [ -x "$c" ] && BUN="$c"
done
if [ -z "$BUN" ]; then
  echo "cc-todo: bun not found" >&2
  exit 1
fi

exec "$BUN" run "$REPO/src/cli/todo.ts" "$@"
