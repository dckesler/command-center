#!/usr/bin/env bash
# cc-review — tuicr-based human review in a review worktree: open, drafts, post, add, hide/unhide/hidden (see src/cli/review.ts).
# Used by the review-ticket agent from its worktree.
#
#   cc-review open|drafts|post|add|hide|unhide|hidden [args]
set -euo pipefail

# Resolve the command-center checkout from this script's real location
# (~/.local/bin/cc-review is a symlink into the repo).
SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$DIR/$SELF" ;; esac
done
REPO="$(cd "$(dirname "$SELF")/../.." && pwd)"

BUN="$(command -v bun || true)"
for c in "$HOME/.bun/bin/bun" /opt/homebrew/bin/bun /usr/local/bin/bun; do
  [ -n "$BUN" ] && break
  [ -x "$c" ] && BUN="$c"
done
if [ -z "$BUN" ]; then
  echo "cc-review: bun not found" >&2
  exit 1
fi

exec "$BUN" run "$REPO/src/cli/review.ts" "$@"
